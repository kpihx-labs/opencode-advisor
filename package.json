{
  "name": "@kpihx-labs/opencode-advisor",
  "version": "0.1.0",
  "description": "OpenCode plugin — advisor() tool + /btw command. KπX sovereign fork (StefanoBalocco base + u007 /btw)",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./btw": {
      "types": "./dist/btw.d.ts",
      "import": "./dist/btw.js"
    }
  },
  "files": [
    "dist/plugin.js",
    "dist/plugin.d.ts",
    "dist/btw.js",
    "dist/btw.d.ts"
  ],
  "scripts": {
    "build": "node build.mjs all",
    "build:plugin": "node build.mjs plugin",
    "build:tests": "node build.mjs tests",
    "tests": "c8 --include=src/plugin.ts --exclude-after-remap --per-file --100 --reporter=text --reporter=lcov ava 'tests/dist/*.test.js' --verbose"
  },
  "keywords": [
    "opencode",
    "plugin",
    "advisor",
    "btw",
    "kpihx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kpihx-labs/opencode-advisor.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-ai/plugin": ">=1.4.9",
    "@opencode-ai/sdk": ">=1.4.9"
  },
  "devDependencies": {
    "typescript": "~6",
    "ava": "~6",
    "c8": "~12",
    "@types/node": "~24"
  }
}
